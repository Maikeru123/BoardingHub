{
  "name": "BoardingHub",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-repository-secrets.mjs",
    "test": "npm run test:validation && npm run test:db",
    "test:validation": "node --import ./scripts/node-os-userinfo-fallback.mjs --import tsx --test tests/validation.test.ts tests/boarding-house-status.test.ts",
    "test:db": "node --test --test-concurrency=1 tests/database.test.mjs tests/photo-migration.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:workflow": "node --test tests/listing-workflow.test.mjs",
    "db:push": "supabase db push --linked",
    "db:seed:accounts": "node scripts/seed-accounts.mjs",
    "db:seed:admin": "node scripts/seed-admin.mjs",
    "db:types": "node scripts/generate-database-types.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@ianlabicani/geoph-lite": "2.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
